<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PlannerTool.ViewModels"
        xmlns:controls="clr-namespace:PlannerTool.Controls"
        x:Class="PlannerTool.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="400" Height="600"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="32"
        FontFamily="{DynamicResource Primary}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <controls:TitleBar/>

        <Border Grid.Row="1" Padding="12" Background="{DynamicResource PrimaryBackground}">
            <ContentControl Content="{Binding CurrentViewModel}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:ProjectContainerViewModel">
                        <controls:ProjectContainer/>
                    </DataTemplate>
                    <DataTemplate DataType="vm:ProjectViewModel">
                        <controls:ProjectView/>
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Border>
    </Grid>
</Window>